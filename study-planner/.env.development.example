APP_NAME="Study Planner Development"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=sqlite
# Use an absolute path in the private .env.development; never a production URL.
DB_DATABASE=database/development.sqlite
DB_URL=
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
HASH_DRIVER=argon2id
# Set privately before running DevelopmentAccountsSeeder.
DEV_SEED_PASSWORD=
