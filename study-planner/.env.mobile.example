# Mobile App Environment Variables
# Copy this to .env.mobile and update for your deployment

# API Base URL - Change this to your Laravel backend URL
# For local testing on device: http://YOUR_COMPUTER_IP:8000/api
# For production: https://your-domain.com/api
VITE_API_BASE_URL=http://YOUR_COMPUTER_IP:8000/api

# App name
VITE_APP_NAME="Study Planner"
