# Configure these in Vercel Project Settings > Environment Variables.
# Root Directory: study-planner; Node.js version: 22.x; Framework: Other.
# APP_KEY must be a persistent key generated with php artisan key:generate --show.
APP_KEY=
APP_URL=https://YOUR_PROJECT.vercel.app
# Use a cloud PostgreSQL URL, with credentials, and SSL enabled.
# The Docker hostname "postgres" and laptop IP addresses cannot be used here.
DB_URL=
DB_SSLMODE=require
# Persistent cache is needed for authentication rate limiting across serverless requests.
CACHE_STORE=database
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
SANCTUM_EXPIRATION=43200

APP_ENV=production
APP_DEBUG=false
HASH_DRIVER=argon2id
SESSION_SECURE_COOKIE=true
