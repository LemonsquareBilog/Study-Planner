{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:mobile && npm run build:web",
        "build:mobile": "vite build",
        "build:web": "vite build --mode web",
        "dev": "vite --mode web",
        "mobile:build": "npm run build:mobile && npx cap sync android",
        "mobile:open": "npx cap open android",
        "mobile:run": "npx cap run android"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "autoprefixer": "^10.6.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.5.2",
        "@capacitor/keyboard": "^8.0.5",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    }
