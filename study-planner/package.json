{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "build": "npm run build:mobile && npm run build:web",
        "build:mobile": "vite build --mode mobile",
        "build:web": "vite build --mode web",
        "vercel-build": "npm run build:web",
        "dev": "vite --mode web",
        "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1",
        "local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 -CheckOnly",
        "preview": "vite preview --outDir www --port 5173 --host",
        "mobile:build": "npm run build:mobile && npx cap sync android",
        "mobile:open": "npx cap open android",
        "mobile:run": "npx cap run android",
        "build:preview": "vite build --mode preview",
        "test:mobile-config": "node --test tests/mobile-config.test.mjs",
        "mobile:check-backend": "node scripts/check-production-api.mjs",
        "test:production-api": "node --test tests/production-api.test.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "autoprefixer": "^10.6.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/app": "^8.1.2",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.5.2",
        "@capacitor/keyboard": "^8.0.5",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@heroicons/vue": "^2.2.0",
        "@zxcvbn-ts/core": "^4.2.0",
        "@zxcvbn-ts/language-common": "^4.1.3",
        "@zxcvbn-ts/language-en": "^4.1.1",
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    }
}
