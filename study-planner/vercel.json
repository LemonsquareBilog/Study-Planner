{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0",
      "config": {
        "excludeFiles": "{node_modules/**,android/**,ios/**,www/**,www_backup/**,tests/**,scripts/**,docs/**,.verification/**,.git/**,.agents/**,.claude/**,agentic-awesome-skills/**,graphify-out/**,resources/js/graphify-out/**,playwright-report/**,test-results/**,.env,.env.*,storage/logs/**,storage/framework/testing/**,database/*.sqlite,public/hot}"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_NAME": "Study Planner",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_CONNECTION": "pgsql",
    "DB_SSLMODE": "require",
    "SESSION_DRIVER": "cookie",
    "SESSION_SECURE_COOKIE": "true",
    "CACHE_STORE": "database",
    "CORS_ALLOWED_ORIGINS": "https://localhost,capacitor://localhost",
    "SANCTUM_EXPIRATION": "43200",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr"
  }
}
